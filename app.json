{
  "expo": {
    "name": "Plantly",
    "slug": "plantly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "plantly",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/splash.png",
        "monochromeImage": "./assets/plan-leaf-appicon-mono-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.plantly"
    },
    "web": {
      "favicon": "./assets/plan-leaf-favicon-48.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["node_modules\\@expo-google-fonts\\caveat\\400Regular\\Caveat_400Regular.ttf"]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9fa9355f-f32a-4f60-ad04-0dc13b77bfd5"
      }
    },
    "owner": "phucsng"
  }
}
